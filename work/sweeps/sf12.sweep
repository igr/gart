# sf12 - a plate from the chamber. a beam comes in from the left through a magnetic field and
# every charged thing bends with r = p * rscale, drawn as the trail of bubbles it boils off.
# heavies cross as long arcs, light ones shed momentum and wind in to a point, some beam tracks
# hit and spray, neutrals come apart further on as vees out of nothing. one event in red.
# run:  just sweep sf12     (writes pngs + one contact sheet per branch to output/sf12)
# 120 renders across 6 branches.

art    = sf.SF12Kt
module = arts:sf
out    = output/sf12
par    = 6

# A new seed rerolls everything: where the beam sits, who hits, which event goes red.
# 71 is the default - one event dead centre, a fan of red arcs and curls under the beam bundle.
# picked out of 1:80. 20 (the old default), 5, 59 and 72 are the other keepers.
[branch cast]
seed = 1:80

# The field. rscale is px of bend per unit momentum, loss what a light track sheds per px. the
# product sets the turns in a spiral, ln(p0/pmin) / (2 pi rscale loss). at 22/0.0045 a p0 = 4
# electron gets ~6 turns and 870 px of trail. loss 0.012 gave 2 turns and read as hooks.
[branch field]
seed   = 71
rscale = 14,22,34
loss   = 0.003,0.0045,0.008

# The beam. with p at 30-70 the bundle fanned and bent like a sheaf of arcs, 45-90 keeps it a
# beam. pint is the share of beam tracks that hit something before leaving.
[branch beam]
seed = 71
beam = 6,11,18
pint = 0.35,0.6,0.85

# The little curls. delta is knock-on electrons per 1000 px of heavy track. they used to leave
# the ray at 50-90 degrees and half of them looped back behind the point - now they peel off
# tangent, on the side they curl toward, so a curl reads as the ray continuing. up to 0.2 rad off,
# 0.45 was still a kink. a curl draws at its parents weight - slow heavies fat, beam thin, and an
# electron inherits whatever it came off. it used to fatten with ionisation and read as a worm.
# bubbles still bunch up as a curl slows, and a solid run of dots reads heavier than a beaded one,
# so dots thin to 0.6 at the closed-up end. that made the curl centres sit at the rays weight.
[branch curls]
seed  = 71
delta = 0,1.3,3,6

# The texture. dot is bubble radius, gap the spacing on a fast track. 3.4/1.15 still shows the
# beads at full size; under 2.5 the trails go solid.
[branch texture]
seed = 71
dot  = 0.9,1.15,1.6
gap  = 2.5,3.4,5

# Background. strays are faint tracks wandering in from the sides, boil the loose bubbles.
[branch background]
seed   = 71
strays = 0,7,16
boil   = 0,1400,4000
