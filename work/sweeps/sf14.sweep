art    = sf.SF14Kt
module = arts:sf
out    = output/sf14
par    = 6
fixed  = ss=2

# A new seed moves the mass, turns the sun round its axis and shifts the bands.
[branch cast]
seed = 1:60

# The sun, size and place both in einstein radii. align 0 is a closed ring, past about sun it
# splits into two arcs, and far off the inner one shrinks to a fleck.
[branch sun]
seed  = 49
sun   = 0.22,0.31,0.4
align = 0,0.25,0.5,0.9

# The mass, its einstein radius as a share of the width. the hole and the sun grow with it.
[branch mass]
seed = 49
mass = 0.15,0.25,0.35
